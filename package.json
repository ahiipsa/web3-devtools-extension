{
  "name": "evm-rpc-inspector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "watch": "vite build --watch",
    "test": "vitest run",
    "icons": "set -e; for size in 16 48 128; do rsvg-convert -w $size -h $size assets/icon.svg -o public/icons/icon-$size.png; done",
    "release": "npm run build && rm -rf release && mkdir release && cd build && zip -qr ../release/evm-rpc-inspector-$npm_package_version.zip ."
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@hookform/resolvers": "^4.0.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.7",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.23",
    "antd": "^5.24.1",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.54.2",
    "tailwindcss": "^4.0.6",
    "viem": "^2.23.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "happy-dom": "^15.11.7",
    "prettier": "3.5.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
